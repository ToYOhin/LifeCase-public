{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifecase.local/schemas/claim-candidate/1.0.0",
  "title": "LifeCase Claim Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["field", "value", "status", "confidence", "source_refs"],
  "properties": {
    "field": { "type": "string", "minLength": 1 },
    "value": {},
    "status": { "enum": ["extracted", "inferred", "unknown"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "source_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "uncertainty_reason": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "extracted" } } },
      "then": { "properties": { "source_refs": { "minItems": 1 } } }
    }
  ]
}
