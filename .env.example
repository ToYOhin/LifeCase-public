LIFECASE_ENV=development
LIFECASE_HOST=127.0.0.1
LIFECASE_PORT=8000
LIFECASE_DATA_DIR=.lifecase
LIFECASE_MODEL_PROVIDER=disabled
# LIFECASE_LIVE_AGENT=false
# LIFECASE_MODEL_ID must be set only when LIFECASE_MODEL_PROVIDER=ollama, openai, groq, mistral, or deepseek.
# Groq is fixed to openai/gpt-oss-20b and remains unavailable unless organization ZDR is
# enabled in the Groq console and LIFECASE_GROQ_ZDR_CONFIRMED=true is set in the process.
# LIFECASE_GROQ_ZDR_CONFIRMED=false
# Mistral is fixed to mistral-small-2603 and remains unavailable unless organization ZDR is
# enabled in Mistral Studio and LIFECASE_MISTRAL_ZDR_CONFIRMED=true is set in the process.
# LIFECASE_MISTRAL_ZDR_CONFIRMED=false
# DeepSeek product composition is synthetic/private-only and also requires an injected process client.
# LIFECASE_DEEPSEEK_DATA_USE_CONFIRMED=false
# LIFECASE_MODEL_TIMEOUT_SECONDS=30
# LIFECASE_MODEL_MAX_INPUT_BYTES=100000
# LIFECASE_MODEL_MAX_OUTPUT_BYTES=64000
# Store real API credentials in Windows Credential Locker, never in this file.
# This repository exposes only injected process-local client boundaries; it does not load a
# credential or construct a provider client from this file.
